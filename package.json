{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "auth:generate": "node --env-file=.env.local node_modules/auth/dist/index.mjs generate --config lib/auth.ts --output db/auth-schema.ts --adapter drizzle --dialect postgresql --yes",
    "actions:discover": "tsx --env-file=.env.local scripts/discover-actions.ts",
    "actions:backfill-open-graph": "tsx --env-file=.env.local scripts/backfill-action-open-graph.ts",
    "organizations:backfill-open-graph": "tsx --env-file=.env.local scripts/backfill-organization-open-graph.ts",
    "organizations:backfill-sidebars": "tsx --env-file=.env.local scripts/backfill-organization-sidebars.ts",
    "issues:backfill-sidebars": "tsx --env-file=.env.local scripts/backfill-issue-sidebars.ts",
    "issues:neutralize-copy": "tsx --env-file=.env.local scripts/neutralize-issue-copy.ts",
    "government:sync": "tsx --env-file=.env.local scripts/sync-congress.ts",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@fontsource/caveat": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "mcp-handler": "^2.1.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
